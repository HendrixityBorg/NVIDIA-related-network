      "body_recovery_method": "wayback",
      "context_excerpt": "The NVIDIA AI Blueprint for video search and summarization (VSS), part of the NVIDIA Metropolis platform , combines generative AI , large language models , vision language models and media management services to deploy visual AI agents that can optimize processes, such as visual inspection and assembly, and enhance worker safety in factories and warehouses.",
      "entity_name_normalized_hint": "AI agents",
      "entity_name_raw": "AI agents",

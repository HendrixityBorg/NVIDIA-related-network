      "archive_timestamp": "20250611171520",
      "article_id": "article_022bc630cc2a6320",
      "body_recovery_method": "wayback",
      "context_excerpt": "To accurately predict and resolve traffic incidents, K2K is generating synthetic data with Cosmos world foundation models to simulate different driving conditions. Then, K2K uses the data to fine-tune the VLMs powering the AI agents with NeMo Curator. These simulations enable K2K’s AI agents to create over 100,000 predictions per second.",
      "entity_name_normalized_hint": "Cosmos world foundation models",
      "entity_name_raw": "Cosmos world foundation models",

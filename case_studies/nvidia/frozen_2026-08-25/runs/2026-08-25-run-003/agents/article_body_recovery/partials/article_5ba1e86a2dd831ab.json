    {
      "access_constraints": "public no-login Internet Archive replay; original publisher copyright retained; no republication grant inferred",
      "archive_timestamp": "20251203192257",
      "article_id": "article_5ba1e86a2dd831ab",
      "body_recovery_method": "wayback",
      "context_excerpt": "The Kimi K2 Thinking MoE model — ranked as the most intelligent open-source model on the AA leaderboard — sees a 10x performance leap on the NVIDIA GB200 NVL72 rack-scale system compared with NVIDIA HGX H200. Building on the performance delivered for the DeepSeek-R1 and Mistral Large 3 MoE models, this breakthrough underscores how MoE is becoming the architecture of choice for frontier models — and why NVIDIA’s full-stack inference platform is the key to unlocking its full potential.",
      "entity_name_normalized_hint": "DeepSeek-R1",
      "entity_name_raw": "DeepSeek-R1",
      "evidence_locator": "body.block[7]",
      "exchange": null,
      "linked_url": "https://blogs.nvidia.com/blog/blackwell-inferencemax-benchmark-results/",
      "listing_evidence_locator": null,

    {
      "access_constraints": "public no-login Internet Archive replay; original publisher copyright retained; no republication grant inferred",
      "archive_timestamp": "20260213003448",
      "article_id": "article_4c0fffc25ccbf353",
      "body_recovery_method": "wayback",
      "context_excerpt": "At Harvard’s Kempner Institute for the Study of Natural and Artificial Intelligence, neuroscientists are using DGX Spark as a compact desktop supercomputer to probe how genetic mutations in the brain drive epilepsy. The system lets researchers run complex analyses in real time without needing to wait for access to large institutional clusters.​",
      "entity_name_normalized_hint": "using DGX Spark",
      "entity_name_raw": "using DGX Spark",
      "evidence_locator": "body.block[14]",
      "exchange": null,
      "linked_url": "https://kempnerinstitute.harvard.edu/news/decoding-epilepsy/",
      "listing_evidence_locator": null,
      "listing_status": "unresolved",
      "mention_source": "anchor",
      "published_date": "2026-02-12",
      "publisher": "NVIDIA Blog",
      "retrieved_url": "https://web.archive.org/web/20260213003448id_/https://blogs.nvidia.com/blog/dgx-spark-higher-education/",
      "source_family": "internet_archive_wayback_replay",

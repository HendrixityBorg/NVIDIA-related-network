      "body_recovery_method": "wayback",
      "context_excerpt": "At NYU’s Global AI Frontier Lab, ​the ICARE (Interpretable and Clinically‑Grounded Agent‑Based Report Evaluation) project runs end-to-end on a DGX Spark in the lab. ICARE uses collaborating AI agents and multiple‑choice question generation to evaluate how closely AI‑generated radiology reports align with expert sources, enabling real‑time clinical evaluation and continuous monitoring without sending medical imaging data to the cloud.​",
      "entity_name_normalized_hint": "ICARE",
      "entity_name_raw": "ICARE",
      "evidence_locator": "body.block[10]",
      "exchange": null,

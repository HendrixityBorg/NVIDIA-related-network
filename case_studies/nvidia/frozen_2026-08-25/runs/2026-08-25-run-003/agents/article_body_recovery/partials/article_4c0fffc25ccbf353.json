    {
      "access_constraints": "public no-login Internet Archive replay; original publisher copyright retained; no republication grant inferred",
      "archive_timestamp": "20260213003448",
      "article_id": "article_4c0fffc25ccbf353",
      "body_recovery_method": "wayback",
      "context_excerpt": "At the Institute of Science and Technology Austria, researchers are using an HP ZGX Nano AI Station — a compact system based on NVIDIA DGX Spark — to train and fine‑tune LLMs right on a desktop. The team’s open source LLMQ software enables working with models of up to 7 billion parameters, making advanced LLM training accessible to more students and researchers.",
      "entity_name_normalized_hint": "open source LLMQ software",
      "entity_name_raw": "open source LLMQ software",
      "evidence_locator": "body.block[26]",
      "exchange": null,
      "linked_url": "https://github.com/IST-DASLab/llmq",
      "listing_evidence_locator": null,
      "listing_status": "unresolved",
      "mention_source": "anchor",
      "published_date": "2026-02-12",
      "publisher": "NVIDIA Blog",
      "retrieved_url": "https://web.archive.org/web/20260213003448id_/https://blogs.nvidia.com/blog/dgx-spark-higher-education/",
      "source_family": "internet_archive_wayback_replay",
